# Backend URL for n8n webhooks
BACKEND_URL=https://knoozbook.com

# n8n Configuration
N8N_API_URL=https://n8n.knoozbook.com
N8N_API_KEY=your_n8n_api_key_here

# Social Media Configuration
META_PAGE_ID=your_facebook_page_id
INSTAGRAM_BUSINESS_ID=your_instagram_business_id
META_ACCESS_TOKEN=your_meta_access_token

# AI Services
OPENAI_API_KEY=your_openai_api_key
WHATSAPP_NUMBER=201xxxxxxxxx

# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/knoozbook?retryWrites=true&w=majority

# Encryption Key (for sensitive data)
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Server Configuration
PORT=3000
NODE_ENV=production

# CORS Configuration
ALLOWED_ORIGINS=https://knoozbook.com,https://www.knoozbook.com
