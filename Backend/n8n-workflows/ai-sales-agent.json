{
  "name": "AI Sales Agent - KnoozBook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sales-agent",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook - Social Media Message",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300],
      "webhookId": "sales-agent-webhook"
    },
    {
      "parameters": {
        "resource": "comment",
        "operation": "get",
        "commentId": "={{ $json.commentId }}",
        "additionalFields": {}
      },
      "id": "fetch-comment",
      "name": "Fetch Comment Details",
      "type": "n8n-nodes-base.facebook",
      "typeVersion": 1,
      "position": [450, 200],
      "credentials": {
        "facebookApi": {
          "id": "facebook-credentials",
          "name": "Facebook API"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "get",
        "messageId": "={{ $json.messageId }}",
        "additionalFields": {}
      },
      "id": "fetch-dm",
      "name": "Fetch DM Details",
      "type": "n8n-nodes-base.facebook",
      "typeVersion": 1,
      "position": [450, 400],
      "credentials": {
        "facebookApi": {
          "id": "facebook-credentials",
          "name": "Facebook API"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/automation/ai-analyze",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": \"{{ $json.message || $json.comment }}\",\n  \"platform\": \"{{ $json.platform }}\",\n  \"userId\": \"{{ $json.userId }}\"\n}",
        "options": {}
      },
      "id": "ai-intent-analysis",
      "name": "AI Intent Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_URL }}/api/automation/recommend-books?category={{ $json.category }}&limit=3",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "fetch-recommendations",
      "name": "Fetch Book Recommendations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.7
        },
        "prompt": "=أنت مساعد مبيعات ودود لموقع كنوز للكتب (KnoozBook). رد باللهجة المصرية البسيطة والودودة.\n\nنيه العميل: {{ $json.intent }}\n\nالكتب الموصى بها:\n{{ $json.recommendations }}\n\nاكتب رد قصير ومحفز للشراء (أقل من 150 كلمة). إذا كان العميل جاد، دعوه للتواصل عبر واتساب على رقم: {{ $env.WHATSAPP_NUMBER }}",
        "messages": "={{ $json.messages }}",
        "responseFormat": {
          "type": "text"
        }
      },
      "id": "generate-response",
      "name": "Generate AI Response",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.5,
      "position": [1050, 300],
      "credentials": {
        "openAiApi": {
          "id": "openai-credentials",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "resource": "comment",
        "operation": "comment",
        "commentId": "={{ $json.commentId }}",
        "message": "={{ $json.response }}",
        "additionalFields": {}
      },
      "id": "reply-comment",
      "name": "Reply to Comment",
      "type": "n8n-nodes-base.facebook",
      "typeVersion": 1,
      "position": [1250, 200],
      "credentials": {
        "facebookApi": {
          "id": "facebook-credentials",
          "name": "Facebook API"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "recipientId": "={{ $json.userId }}",
        "message": "={{ $json.response }}",
        "additionalFields": {}
      },
      "id": "reply-dm",
      "name": "Reply to DM",
      "type": "n8n-nodes-base.facebook",
      "typeVersion": 1,
      "position": [1250, 400],
      "credentials": {
        "facebookApi": {
          "id": "facebook-credentials",
          "name": "Facebook API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "serious-buyer",
              "leftValue": "={{ $json.intent }}",
              "rightValue": "purchase",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-serious-buyer",
      "name": "Check Serious Buyer",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/automation/log",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"comment\",\n  \"platform\": \"{{ $json.platform }}\",\n  \"status\": \"success\",\n  \"title\": \"AI Sales Agent Response\",\n  \"details\": {\n    \"message\": \"{{ $json.message }}\",\n    \"response\": \"{{ $json.response }}\",\n    \"intent\": \"{{ $json.intent }}\"\n  },\n  \"metadata\": {\n    \"userId\": \"{{ $json.userId }}\",\n    \"commentId\": \"{{ $json.commentId }}\"\n  }\n}",
        "options": {}
      },
      "id": "log-interaction",
      "name": "Log Interaction",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1650, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"AI response sent successfully\",\n  \"data\": {\n    \"intent\": \"{{ $json.intent }}\",\n    \"response\": \"{{ $json.response }}\",\n    \"timestamp\": \"{{ $now.toISO() }}\"\n  }\n}"
      },
      "id": "response",
      "name": "Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1850, 300]
    }
  ],
