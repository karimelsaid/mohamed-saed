{
  "name": "Social Media Automation V3 - KnoozBook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "auto-post",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook - Auto Post Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300],
      "webhookId": "auto-post-webhook-v3"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-product-id",
              "leftValue": "={{ $json.productId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "validate-data",
      "name": "Validate Input Data",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_URL }}/api/automation/product/{{ $json.productId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "fetch-product",
      "name": "Fetch Product from Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/ai/execute",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"task\": \"generate_caption\",\n  \"data\": {\n    \"name\": \"{{ $json.product.name }}\",\n    \"description\": \"{{ $json.product.description }}\",\n    \"price\": \"{{ $json.product.price }}\",\n    \"category\": \"{{ $json.product.category }}\"\n  },\n  \"options\": {\n    \"returnJSON\": true\n  }\n}",
        "options": {}
      },
      "id": "ai-generate-content",
      "name": "AI Generate Content (AI Orchestrator)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse AI content and prepare for each platform\nconst aiResult = $input.item.json;\nconst content = aiResult.json || aiResult.content; // Handle both formats\nconst product = $input.first().json.product;\n\n// Prepare Facebook payload\nconst facebookPayload = {\n  caption: content.caption,\n  hashtags: content.hashtags.join(' '),\n  fullCaption: content.caption + '\\n\\n' + content.hashtags.join(' '),\n  product: {\n    ...product,\n    link: product.link + (product.link.includes('?') ? '&' : '?') + 'utm_source=facebook&utm_campaign=auto_post&utm_medium=social_media'\n  },\n  platform: 'facebook',\n  aiMetadata: {\n    model: aiResult.model,\n    provider: aiResult.provider,\n    cost: aiResult.cost,\n    tokens: aiResult.tokens,\n    executionTime: aiResult.executionTime\n  }\n};\n\n// Prepare Instagram payload\nconst instagramPayload = {\n  caption: content.caption,\n  hashtags: content.hashtags.join(' '),\n  fullCaption: content.caption + '\\n\\n' + content.hashtags.join(' '),\n  product: {\n    ...product,\n    link: product.link + (product.link.includes('?') ? '&' : '?') + 'utm_source=instagram&utm_campaign=auto_post&utm_medium=social_media'\n  },\n  platform: 'instagram',\n  aiMetadata: {\n    model: aiResult.model,\n    provider: aiResult.provider,\n    cost: aiResult.cost,\n    tokens: aiResult.tokens,\n    executionTime: aiResult.executionTime\n  }\n};\n\n// Return both payloads\nreturn [\n  { json: facebookPayload },\n  { json: instagramPayload }\n];"
      },
      "id": "prepare-platforms",
      "name": "Prepare Platform-Specific Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "merge-platforms",
      "name": "Merge Platform Content",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "json",
        "options": {}
      },
      "id": "split-platforms",
      "name": "Split by Platform",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-facebook",
              "leftValue": "={{ $json.platform }}",
              "rightValue": "facebook",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "route-platform",
      "name": "Route by Platform",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1650, 300]
    },
    {
      "parameters": {
        "resource": "page",
        "operation": "post",
        "pageId": "={{ $env.META_PAGE_ID }}",
        "text": "={{ $json.fullCaption }}",
        "imageUrl": "={{ $json.product.image }}",
        "link": "={{ $json.product.link }}",
        "additionalFields": {}
      },
      "id": "facebook-post",
      "name": "Post to Facebook",
      "type": "n8n-nodes-base.facebook",
      "typeVersion": 1,
      "position": [1850, 200],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "facebookApi": {
          "id": "facebook-credentials",
          "name": "Facebook API"
        }
      }
    },
    {
      "parameters": {
        "resource": "container",
        "operation": "create",
        "caption": "={{ $json.fullCaption }}",
        "imageUrl": "={{ $json.product.image }}",
        "link": "={{ $json.product.link }}",
        "additionalFields": {}
      },
      "id": "instagram-post",
      "name": "Post to Instagram",
      "type": "n8n-nodes-base.instagram",
      "typeVersion": 1,
      "position": [1850, 400],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "instagramApi": {
          "id": "instagram-credentials",
          "name": "Instagram API"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "multiplex",
        "options": {}
      },
      "id": "merge-results",
      "name": "Merge Post Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [2050, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/automation/log",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"post\",\n  \"platform\": \"multi\",\n  \"status\": \"success\",\n  \"title\": \"Auto-Post: {{ $json.product.name }}\",\n  \"details\": {\n    \"caption\": \"{{ $json.caption }}\",\n    \"hashtags\": \"{{ $json.hashtags }}\",\n    \"platform\": \"{{ $json.platform }}\",\n    \"imageUrl\": \"{{ $json.product.image }}\",\n    \"link\": \"{{ $json.product.link }}\"\n  },\n  \"metadata\": {\n    \"productId\": \"{{ $json.product.id }}\"\n  }\n}",
        "options": {}
      },
      "id": "log-success",
      "name": "Log Success to Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2250, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Product posted successfully to social media\",\n  \"data\": {\n    \"productId\": \"{{ $json.product.id }}\",\n    \"name\": \"{{ $json.product.name }}\",\n    \"caption\": \"{{ $json.caption }}\",\n    \"hashtags\": \"{{ $json.hashtags }}\",\n    \"platforms\": [\"facebook\", \"instagram\"],\n    \"timestamp\": \"{{ $now.toISO() }}\"\n  }\n}"
      },
      "id": "response",
      "name": "Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/automation/log",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"post\",\n  \"platform\": \"error\",\n  \"status\": \"failed\",\n  \"title\": \"Validation Error\",\n  \"details\": {\n    \"error\": \"Missing productId in request\"\n  },\n  \"metadata\": {\n    \"input\": {{ $json }}\n  }\n}",
        "options": {}
      },
      "id": "log-validation-error",
      "name": "Log Validation Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 150]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"message\": \"Validation failed: productId is required\"\n}"
      },
      "id": "error-response",
      "name": "Error Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [850, 150]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/automation/log",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"post\",\n  \"platform\": \"error\",\n  \"status\": \"failed\",\n  \"title\": \"Post Failed After Retries\",\n  \"details\": {\n    \"error\": \"{{ $json.error.message }}\",\n    \"productId\": \"{{ $json.product.id }}\"\n  },\n  \"metadata\": {\n    \"productId\": \"{{ $json.product.id }}\"\n  }\n}",
        "options": {}
      },
      "id": "log-post-error",
      "name": "Log Post Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2050, 500]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"message\": \"Failed to post after retries\",\n  \"error\": \"{{ $json.error.message }}\"\n}"
      },
      "id": "error-response-2",
      "name": "Error Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2250, 500]
    }
  ],
