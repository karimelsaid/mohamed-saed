{
  "name": "YouTube Video Automation - إنشاء ونشر الفيديوهات",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "youtube-video-create",
        "options": {}
      },
      "id": "e434cd6d-c9b0-4f81-8b09-cf80f9797e59",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "webhookId": "youtube-video-create"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.contentType }}",
              "value2": "text_summary"
            }
          ]
        }
      },
      "id": "18a4a58b-0c91-49b8-a733-1b913cd2f0a1",
      "name": "Check Content Type",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "gpt-4o-mini"
            },
            {
              "name": "messages",
              "value": "=[{\"role\": \"system\", \"content\": \"أنت مساعد ذكي متخصص في تحويل النصوص إلى سكريبت فيديو يوتيوب مشوق ومختصر.\"}, {\"role\": \"user\", \"content\": \"قم بإنشاء سكريبت فيديو ملخص من النص التالي: {{ $json.body.sourceContent }}\"}]"
            }
          ]
        },
        "options": {}
      },
      "id": "cfcf1ab7-99f5-41e7-8b00-349f2b8764b8",
      "name": "Generate Script from Text (OpenAI / NotebookLM alt)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        720,
        180
      ]
    },
    {
      "parameters": {
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "gpt-4o-mini"
            },
            {
              "name": "messages",
              "value": "=[{\"role\": \"system\", \"content\": \"أنت مساعد ذكي متخصص في تلخيص فيديوهات اليوتيوب.\"}, {\"role\": \"user\", \"content\": \"قم بإنشاء ملخص للفيديو الموجود في الرابط التالي لتسجيله كفيديو جديد: {{ $json.body.sourceContent }}\"}]"
            }
          ]
        },
        "options": {}
      },
      "id": "e44d5c4b-b2cd-4740-b4bd-771141ef3f40",
      "name": "Summarize Video URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        720,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.heygen.com/v1/video.generate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "script",
              "value": "={{ $json.choices[0].message.content }}"
            },
            {
              "name": "title",
              "value": "={{ $('Webhook Trigger').item.json.body.title }}"
            }
          ]
        },
        "options": {}
      },
      "id": "670f5e1f-1c4c-42b7-a3e9-a4b51a8f62f3",
      "name": "Generate Video (HeyGen / AI Video Generator)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "title": "={{ $('Webhook Trigger').item.json.body.title }}",
        "description": "={{ $('Webhook Trigger').item.json.body.description }}",
        "categoryId": "={{ $('Webhook Trigger').item.json.body.category === 'Education' ? '27' : '22' }}",
        "privacyStatus": "={{ $('Webhook Trigger').item.json.body.privacy }}",
        "tags": "={{ $('Webhook Trigger').item.json.body.tags.join(',') }}",
        "file": "={{ $json.video_url }}"
      },
      "id": "b1b74730-80a5-4eb8-b1dc-e300d6df6cf2",
      "name": "Upload to YouTube",
      "type": "n8n-nodes-base.youtube",
      "typeVersion": 1,
      "position": [
        1240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Webhook Trigger').item.json.body.callbackUrl }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "published"
            },
            {
              "name": "youtubeVideoId",
              "value": "={{ $json.id }}"
            },
            {
              "name": "youtubeUrl",
              "value": "=https://youtube.com/watch?v={{ $json.id }}"
            },
            {
              "name": "n8nExecutionId",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "3587ec1f-d7b3-462f-8703-9dcdfbab3d08",
      "name": "Success Callback to Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Webhook Trigger').item.json.body.callbackUrl }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "failed"
            },
            {
              "name": "errorMessage",
              "value": "={{ $error.message }}"
            },
            {
              "name": "n8nExecutionId",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "893c8ea4-68f8-4e1b-b4a1-8d26fb04c861",
      "name": "Error Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1460,
        500
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Check Content Type",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Content Type": {
      "main": [
        [
          {
            "node": "Generate Script from Text (OpenAI / NotebookLM alt)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Summarize Video URL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Script from Text (OpenAI / NotebookLM alt)": {
      "main": [
        [
          {
            "node": "Generate Video (HeyGen / AI Video Generator)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Summarize Video URL": {
      "main": [
        [
          {
            "node": "Generate Video (HeyGen / AI Video Generator)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Video (HeyGen / AI Video Generator)": {
      "main": [
        [
          {
            "node": "Upload to YouTube",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload to YouTube": {
      "main": [
        [
          {
            "node": "Success Callback to Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "893c8ea4-68f8-4e1b-b4a1-8d26fb04c861"
  }
}
