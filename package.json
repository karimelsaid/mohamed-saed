{
  "name": "kenouz",
  "version": "1.5.5",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve kenouz --proxy-config proxy.conf.json --port 4200 --open",
    "dev:no-ssr": "ng serve kenouz --proxy-config proxy.conf.json --port 4200 --open -c no-ssr",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:prod": "ng build kenouz --configuration production && npm run zip:mobile",
    "zip:mobile": "node Backend/scripts/zip-dist.js",
    "capacitor:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "ng build kenouz --configuration mobile && npm run capacitor:sync && npx cap open android",
    "capacitor:sync:ios": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:run": "ng build kenouz --configuration mobile && npm run capacitor:sync:ios && npx cap open ios",
    "kenouz:build": "ng build kenouz",
    "mushaf:serve": "ng serve mushaf-wird --proxy-config proxy.conf.json",
    "mushaf:build": "ng build mushaf-wird",
    "mushaf:android:sync": "cd mushaf-wird-mobile && npx cap sync android",
    "mushaf:android:open": "cd mushaf-wird-mobile && npx cap open android",
    "mushaf:android:run": "npm run mushaf:build && npm run mushaf:android:sync && npm run mushaf:android:open",
    "mushaf:ios:sync": "cd mushaf-wird-mobile && npx cap sync ios",
    "mushaf:ios:open": "cd mushaf-wird-mobile && npx cap open ios",
    "mushaf:ios:run": "npm run mushaf:build && npm run mushaf:ios:sync && npm run mushaf:ios:open"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~19.1.0",
    "@angular/common": "~19.1.0",
    "@angular/compiler": "~19.1.0",
    "@angular/core": "~19.1.0",
    "@angular/forms": "~19.1.0",
    "@angular/platform-browser": "~19.1.0",
    "@angular/platform-browser-dynamic": "~19.1.0",
    "@angular/platform-server": "~19.1.0",
    "@angular/router": "~19.1.0",
    "@angular/service-worker": "~19.1.0",
    "@angular/ssr": "~19.1.0",
    "@capacitor-community/keep-awake": "^7.0.0",
    "@capacitor/android": "^7.4.1",
    "@capacitor/app": "^7.1.0",
    "@capacitor/browser": "^7.0.3",
    "@capacitor/cli": "^7.4.1",
    "@capacitor/core": "^7.4.1",
    "@capacitor/dialog": "^7.0.3",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/ios": "^7.5.0",
    "@capacitor/local-notifications": "^7.0.4",
    "@capacitor/push-notifications": "^7.0.4",
    "@capacitor/share": "^7.0.0",
    "@capacitor/status-bar": "^7.0.4",
    "@capawesome-team/capacitor-android-foreground-service": "^7.0.0",
    "@capawesome/capacitor-app-update": "^7.2.0",
    "@capgo/capacitor-updater": "^8.43.10",
    "@capgo/native-audio": "^7.11.2",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@fortawesome/angular-fontawesome": "^1.0.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "capacitor-native-settings": "^7.0.2",
    "chart.js": "^4.5.1",
    "dotenv": "^17.3.1",
    "emailjs-com": "^3.2.0",
    "engine.io-client": "^6.6.4",
    "epubjs": "^0.3.93",
    "express": "^4.22.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "libarchive.js": "^2.0.2",
    "lines-and-columns": "^2.0.4",
    "mdb-reader": "^3.1.0",
    "mongoose": "^9.2.1",
    "ng2-charts": "^10.0.0",
    "ngx-skeleton-loader": "^11.2.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "4.4.168",
    "peerjs": "^1.5.5",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "socket.io-parser": "^4.2.5",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.1.2",
    "@angular/build": "^19.2.22",
    "@angular/cli": "^19.1.2",
    "@angular/compiler-cli": "^19.1.0",
    "@types/jasmine": "~5.1.0",
    "@types/peerjs": "^0.0.30",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2"
  }
}
