{
  "name": "kenouz",
  "version": "1.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:prod": "ng build kenouz --configuration production",
    "capacitor:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run build:prod && npm run capacitor:sync && npx cap open android",
    "capacitor:sync:ios": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:run": "npm run build:prod && npm run capacitor:sync:ios && npx cap open ios",
    "kenouz:build": "ng build kenouz",
    "mushaf:serve": "ng serve mushaf-wird --proxy-config proxy.conf.json",
    "mushaf:build": "ng build mushaf-wird",
    "mushaf:android:sync": "cd mushaf-wird-mobile && npx cap sync android",
    "mushaf:android:open": "cd mushaf-wird-mobile && npx cap open android",
    "mushaf:android:run": "npm run mushaf:build && npm run mushaf:android:sync && npm run mushaf:android:open",
    "mushaf:ios:sync": "cd mushaf-wird-mobile && npx cap sync ios",
    "mushaf:ios:open": "cd mushaf-wird-mobile && npx cap open ios",
    "mushaf:ios:run": "npm run mushaf:build && npm run mushaf:ios:sync && npm run mushaf:ios:open"
  },
  "private": true,
  "dependencies": {
