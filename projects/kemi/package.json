{
  "name": "kemi",
  "productName": "kemi",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:electron": "tsc --project tsconfig.electron.json",
    "electron": "npm run build && npm run build:electron && electron .",
    "electron:dev": "concurrently \"npm run start\" \"wait-on http://localhost:4201 && npm run build:electron && electron .\"",
    "watch": "ng build --watch --configuration development",
    "dist:mac": "npm run build && npm run build:electron && electron-builder --mac",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win",
    "dist": "npm run build && npm run build:electron && electron-builder"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "fluent-ffmpeg": "^2.1.2",
    "onnxruntime-node": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "wait-on": "^9.5.1"
  },
  "main": "dist/electron/main.js",
  "build": {
    "appId": "com.kemi.app",
    "productName": "kemi",
    "executableName": "kemi",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "compression": "normal",
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**",
      "node_modules/@ffprobe-installer/**",
      "assets/fonts/**",
      "scripts/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.video",
      "artifactName": "kemi-mac.zip",
      "target": [
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "kemi-win.zip",
      "target": [
        "zip"
      ]
    }
  }
}
