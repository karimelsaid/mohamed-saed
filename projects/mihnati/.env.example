# ==============================================================================
# Mihnati Platform — Environment Configuration Template
# NOTE: Do NOT put production secrets in this file or commit .env to source control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
API_PREFIX=/api/v1

# MongoDB 8.0.x Configuration (Native Driver)
# Local development replica set or Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/mihnati
MONGODB_DB_NAME=mihnati
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Security & Sessions (Opaque server-side sessions, cookies)
SESSION_SECRET=dev-session-secret-must-be-at-least-32-characters-long
SESSION_ACCESS_LIFETIME_MINUTES=15
SESSION_REFRESH_LIFETIME_DAYS=30
SESSION_IDLE_EXPIRY_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=localhost

# CORS Allowed Origins (comma-separated, no wildcards in credentials mode)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Structured Logging & Observability
LOG_LEVEL=info
LOG_FORMAT=json

# Global Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Integration Adapter Drivers (In E01, fake adapters are default)
STORAGE_DRIVER=fake
OTP_DRIVER=fake
MAPS_DRIVER=fake
NOTIFICATION_DRIVER=fake
PAYMENT_DRIVER=fake

